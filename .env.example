# BACKEND CONFIGURATION

## Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase

## JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-required

## Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# WEB CONFIGURATION

## API Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=10000

# MOBILE CONFIGURATION

## API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_TIMEOUT=10000

# COMMON

## Firebase Emulator (local development only)
FIRESTORE_EMULATOR_HOST=localhost:8080
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# TEF Configuration
TEF_PROVIDER=stone                      # stone | elo | ingenico
TEF_DEBUG=true
TEF_LOG_LEVEL=debug

# Stone SDK
TEF_STONE_APP_ID=
TEF_STONE_APP_SECRET=
TEF_STONE_MERCHANT_ID=
TEF_STONE_ENCRYPTION_KEY=
TEF_STONE_LIB_PATH=/opt/tef-sdks/stone/lib

# Elo SDK
TEF_ELO_TERMINAL_ID=
TEF_ELO_API_KEY=
TEF_ELO_LIB_PATH=/opt/tef-sdks/elo/lib

# Ingenico SDK
TEF_INGENICO_TERMINAL_ID=
TEF_INGENICO_API_KEY=
TEF_INGENICO_LIB_PATH=/opt/tef-sdks/ingenico/lib

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Email (para notificações)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@claudepp.com.br

# Sentry (error tracking)
SENTRY_DSN=

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
