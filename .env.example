# Backend
NODE_ENV=development
PORT=3000

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# JWT
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRATION=7d

# Database
FIRESTORE_EMULATOR_HOST=localhost:8080  # Para desenvolvimento local

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# TEF Configuration
TEF_PROVIDER=stone                      # stone | elo | ingenico
TEF_DEBUG=true
TEF_LOG_LEVEL=debug

# Stone SDK
TEF_STONE_APP_ID=
TEF_STONE_APP_SECRET=
TEF_STONE_MERCHANT_ID=
TEF_STONE_ENCRYPTION_KEY=
TEF_STONE_LIB_PATH=/opt/tef-sdks/stone/lib

# Elo SDK
TEF_ELO_TERMINAL_ID=
TEF_ELO_API_KEY=
TEF_ELO_LIB_PATH=/opt/tef-sdks/elo/lib

# Ingenico SDK
TEF_INGENICO_TERMINAL_ID=
TEF_INGENICO_API_KEY=
TEF_INGENICO_LIB_PATH=/opt/tef-sdks/ingenico/lib

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Email (para notificações)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@claudepp.com.br

# Sentry (error tracking)
SENTRY_DSN=

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
