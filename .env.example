# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App Configuration
VITE_APP_ENV=development
VITE_API_URL=http://localhost:3000
VITE_ENABLE_AI=true
VITE_ENABLE_FISCAL=true
VITE_ENABLE_MULTICOMPANY=true

# LLM Provider Configuration
# Options: 'claude' (default), 'openai', 'gemini'
VITE_LLM_PROVIDER=claude

# Claude (Anthropic) Configuration
VITE_ANTHROPIC_API_KEY=sk-ant-...
VITE_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI Configuration (Optional)
# Uncomment to enable OpenAI as provider
# VITE_OPENAI_API_KEY=sk-proj-...
# VITE_OPENAI_MODEL=gpt-4-turbo

# Google Gemini Configuration (Optional)
# Uncomment to enable Gemini as provider
# VITE_GEMINI_API_KEY=...
# VITE_GEMINI_MODEL=gemini-1.5-pro
